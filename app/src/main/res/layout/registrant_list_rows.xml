<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/registrantNameText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="4"
        android:text="@string/registrant_name_text"
        android:textSize="@dimen/registrant_list_font_size" />

    <TextView
        android:id="@+id/registrantKanaText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="4"
        android:text="@string/registrant_kana_text"
        android:textSize="@dimen/registrant_list_font_size" />

    <TextView
        android:id="@+id/registrantBirthdayText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="3"
        android:text="@string/registrant_birthday_text"
        android:textSize="@dimen/registrant_list_font_size" />

    <TextView
        android:id="@+id/registrantGenderText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/registrant_gender_text"
        android:textSize="@dimen/registrant_list_font_size" />

    <Space
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.2" />

    <Button
        android:id="@+id/registrantSelectButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.6"
        android:backgroundTint="@color/green"
        android:text="@string/registrant_select_button"
        android:textSize="@dimen/registrant_list_font_size"
        app:cornerRadius="@dimen/common_button_corner_radius_size" />

    <Space
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.2" />
</LinearLayout>