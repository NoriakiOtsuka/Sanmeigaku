<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/registrantNameText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="5"
        android:ellipsize="end"
        android:hint="@string/registrant_name_text"
        android:maxLines="1"
        android:textSize="@dimen/registrant_list_font_size" />

    <TextView
        android:id="@+id/registrantKanaText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="5"
        android:ellipsize="end"
        android:hint="@string/registrant_kana_text"
        android:maxLines="1"
        android:textSize="@dimen/registrant_list_font_size" />

    <TextView
        android:id="@+id/registrantBirthdayText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="4"
        android:hint="@string/registrant_birthday_text"
        android:textSize="@dimen/registrant_list_font_size" />

    <TextView
        android:id="@+id/registrantGenderText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:hint="@string/registrant_gender_text"
        android:textSize="@dimen/registrant_list_font_size" />

    <Space
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.1" />

    <Button
        android:id="@+id/registrantSettingButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2.3"
        android:backgroundTint="@color/green"
        android:text="@string/registrant_setting_button"
        android:textSize="@dimen/registrant_list_font_size"
        app:cornerRadius="@dimen/common_button_corner_radius_size" />

    <Space
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.2" />

    <Button
        android:id="@+id/registrantDivineButton"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2.3"
        android:backgroundTint="@color/orange"
        android:text="@string/registrant_divine_button"
        android:textSize="@dimen/registrant_list_font_size"
        app:cornerRadius="@dimen/common_button_corner_radius_size" />

    <Space
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.1" />
</LinearLayout>