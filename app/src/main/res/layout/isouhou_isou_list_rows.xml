<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/isouAgeText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="@integer/isouhou_isoulist_age_weight" />

    <TextView
        android:id="@+id/isouTaiunText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="@integer/isouhou_isoulist_taiun_weight" />

    <TextView
        android:id="@+id/isouNenunText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="@integer/isouhou_isoulist_nenun_weight" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="@integer/isouhou_isoulist_isouhou_weight"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/isouNenunDayText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:ignore="NestedWeights" />

        <TextView
            android:id="@+id/isouNenunMonthText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/isouNenunYearText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>
</LinearLayout>